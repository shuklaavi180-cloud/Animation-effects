<!DOCTYPE html>
<html><head><meta charset="utf-8"><style>
body{background:#0b1020;color:#fff;display:grid;place-items:center;min-height:100vh;margin:0}
.stage{position:relative;width:360px;height:220px;display:grid;place-items:center}
.neon{padding:14px 34px;font:700 16px system-ui;color:#5eead4;background:transparent;border:2px solid #5eead4;
  border-radius:12px;cursor:pointer;animation:neon 1.8s ease-in-out infinite;transition:.25s}
.neon:hover{background:#5eead4;color:#04201c;transform:scale(1.06)}
@keyframes neon{0%,100%{box-shadow:0 0 6px #5eead4,inset 0 0 6px #5eead455}
  50%{box-shadow:0 0 26px #5eead4,0 0 50px #5eead477,inset 0 0 14px #5eead477}}
</style></head><body>
<div class="stage">
<button class="neon">Borrow Book</button>
</div>
</body></html>
